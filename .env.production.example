
# Docker image configuration
DOCKERHUB_USERNAME=genvicure
BACKEND_TAG=v1.0.0
FRONTEND_TAG=v1.0.1

# PostgreSQL configuration
POSTGRES_DB=genvicure_treasury
POSTGRES_USER=genvicure_mis
POSTGRES_PASSWORD=CHANGE_ME

# Database connection
DATABASE_URL=postgresql+psycopg://genvicure_mis:CHANGE_ME@postgres:5432/genvicure_treasury

# Application security
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Microsoft Graph - OneDrive Treasury Sync
MS_TENANT_ID=YOUR_TENANT_ID
MS_CLIENT_ID=YOUR_CLIENT_ID
MS_CLIENT_SECRET=YOUR_CLIENT_SECRET
MS_DRIVE_ID=YOUR_DRIVE_ID
MS_FILE_ID=YOUR_FILE_ID

# Automatic synchronization
MS_SYNC_ENABLED=true
MS_SYNC_INTERVAL_MINUTES=5
